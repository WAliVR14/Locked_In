# Ignore virtual environments (they are very heavy, and everyone creates their own)
venv/
env/
.venv/

# Ignore Python temporary files
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Ignore environment variables (YOUR PASSWORDS GO HERE; THEY ARE NEVER UPLOADED)
.env
*.env
!.env.example

# Ignore local databases
*.db
*.sqlite3

# Ignore heavy frontend libraries
node_modules/
dist/
dist-ssr/
*.local